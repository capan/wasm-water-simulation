# Copy to deploy/deploy.env and fill in for your box. That file is gitignored:
# it names the host's directory layout and the containers already running on it,
# none of which belongs in the repo. The values below are placeholders, not a
# working config -- scripts/deploy.sh refuses to run until you replace them.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# Anything already set in your environment wins, so a one-off deploy can be
# WATER_SERVER=user@host ./scripts/deploy.sh.

# ssh target. An alias in ~/.ssh/config keeps the address and login out of git.
WATER_SERVER=my-server

# Where this app's files land on the server.
APP_DIR=/path/to/app

# Directory the shared Caddy imports site blocks from, and the name of its
# container, so a deploy can drop in this repo's routing and reload it.
SITES_DIR=/path/to/caddy/sites
CADDY_CONTAINER=my-caddy-container

# External docker network the app joins so Caddy can reach it by container name.
# Must already exist on the box (`docker network ls`).
WEB_NETWORK=my-shared-network
